# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=production-grade-halal-dining-jwt-secret-key-2026-secure

# PostgreSQL Database Connection
# When blank or if PostgreSQL is unreachable, the system automatically uses
# the resilient embedded SQLite database with identical schema and full seed data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/halal_directory_db

# Google Gemini AI Integration
# Replace with your active Google Gemini API Key from Google AI Studio
# If left empty, a high-fidelity deterministic offline AI simulator operates for demo purposes.
GEMINI_API_KEY=

# Client Base URL for CORS
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
